<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#26000000" />
            <stroke android:width="4dp" android:color="#70FFFFFF" />
        </shape>
    </item>
    <item android:insetLeft="23dp" android:insetTop="23dp" android:insetRight="23dp" android:insetBottom="23dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF3B48" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
